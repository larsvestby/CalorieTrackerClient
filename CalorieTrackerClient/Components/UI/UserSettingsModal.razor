@inject IUserService UserService
@inject IAuthService AuthService

<ModalContainer OnClose="OnClose" ShowCloseButton="false">
    <div class="user-settings-modal">
        <h3 class="modal-title">• User Settings</h3>

        @if (isLoading)
        {
            <p class="modal-status">Loading...</p>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <p class="modal-status error">@loadError</p>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="Save" class="form">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="form-error">@error</p>
                }

                <div class="grid">
                    <div class="form-group">
                        <TextInput Label="First Name" Placeholder="First name..." @bind-Value="model.FirstName" />
                        <ValidationMessage For="@(() => model.FirstName)" />
                    </div>

                    <div class="form-group">
                        <TextInput Label="Last Name" Placeholder="Last name..." @bind-Value="model.LastName" />
                        <ValidationMessage For="@(() => model.LastName)" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="age">Age</label>
                    <InputNumber id="age" class="form-control" @bind-Value="model.Age" />
                    <ValidationMessage For="@(() => model.Age)" />
                </div>

                <div class="grid">
                    <div class="form-group">
                        <label class="form-label" for="height">Height (cm)</label>
                        <InputNumber id="height" class="form-control" @bind-Value="model.Height" />
                        <ValidationMessage For="@(() => model.Height)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="weight">Weight (kg)</label>
                        <InputNumber id="weight" class="form-control" @bind-Value="model.Weight" />
                        <ValidationMessage For="@(() => model.Weight)" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="gender">Gender</label>
                    <InputSelect id="gender" class="form-control" @bind-Value="model.SelectedGender">
                        <option value="@Gender.Male">Male</option>
                        <option value="@Gender.Female">Female</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => model.SelectedGender)" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="activityLevel">Activity Level</label>
                    <InputSelect id="activityLevel" class="form-control" @bind-Value="model.ActivityLevelID">
                        <option value="0" disabled>Select activity level</option>
                        @foreach (var level in activityLevels)
                        {
                            <option value="@level.ActivityLevelID">@level.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.ActivityLevelID)" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="goal">Goal</label>
                    <InputSelect id="goal" class="form-control" @bind-Value="model.GoalID">
                        <option value="0" disabled>Select goal</option>
                        @foreach (var goal in goals)
                        {
                            <option value="@goal.GoalID">@goal.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.GoalID)" />
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-danger btn-pill" @onclick="OnClose">
                        Discard
                    </button>

                    <button type="submit" class="btn btn-primary btn-pill" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                </div>
            </EditForm>
        }
    </div>
</ModalContainer>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private UserSettingsModel model = new();
    private List<ActivityLevelDto> activityLevels = new();
    private List<GoalDto> goals = new();

    private bool isLoading = true;
    private bool isSaving;
    private string? loadError;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        activityLevels = AuthService.GetActivityLevels();
        goals = AuthService.GetGoals();

        try
        {
            var user = await UserService.GetMeAsync();

            if (user is null)
            {
                loadError = "Could not load user settings.";
                return;
            }

            model = new UserSettingsModel
                {
                    FirstName = user.FirstName,
                    LastName = user.LastName,
                    Age = user.Age,
                    Height = user.Height,
                    Weight = user.Weight,
                    SelectedGender = user.SelectedGender,
                    ActivityLevelID = user.ActivityLevelID,
                    GoalID = user.GoalID
                };
        }
        catch
        {
            loadError = "Could not load user settings.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Save()
    {
        error = null;
        isSaving = true;

        try
        {
            var dto = new UpdateUserDto
                {
                    FirstName = model.FirstName,
                    LastName = model.LastName,
                    Age = model.Age,
                    Height = model.Height,
                    Weight = model.Weight,
                    SelectedGender = model.SelectedGender,
                    ActivityLevelID = model.ActivityLevelID,
                    GoalID = model.GoalID
                };

            var success = await UserService.UpdateMeAsync(dto);

            if (!success)
            {
                error = "Could not save settings.";
                return;
            }

            await OnSaved.InvokeAsync();
        }
        catch
        {
            error = "Something went wrong.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private class UserSettingsModel
    {
        [Required(ErrorMessage = "First name is required")]
        [StringLength(50)]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        [StringLength(50)]
        public string LastName { get; set; } = string.Empty;

        [Range(1, 120, ErrorMessage = "Enter a valid age")]
        public int Age { get; set; }

        [Range(1.0, 300.0, ErrorMessage = "Enter a valid height in cm")]
        public double Height { get; set; }

        [Range(1.0, 500.0, ErrorMessage = "Enter a valid weight in kg")]
        public double Weight { get; set; }

        public Gender SelectedGender { get; set; } = Gender.Male;

        [Range(1, int.MaxValue, ErrorMessage = "Please select an activity level")]
        public int ActivityLevelID { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Please select a goal")]
        public int GoalID { get; set; }
    }
}