@inject IFoodItemService FoodItemService

<ModalContainer OnClose="OnClose" ShowCloseButton="false">
    <div class="new-food-modal">
        <h3 class="modal-title">• New Food Item</h3>

        <EditForm Model="model" OnValidSubmit="Save" class="form">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(error))
            {
                    <p class="form-error">@error</p>
            }

            <div class="form-group">
                <TextInput Label="Name" Placeholder="Enter food name..." @bind-Value="model.Name" />
                <ValidationMessage For="@(() => model.Name)" />
            </div>

            <div class="form-group">
                <TextInput Label="Brand (Optional)" Placeholder="Enter brand name..." @bind-Value="model.Brand" />
                <ValidationMessage For="@(() => model.Brand)" />
            </div>

            <h4>All Values Per 100g</h4>

            <div class="grid">
                <div class="form-group">
                    <label class="form-label" for="calories">Calories</label>
                    <InputNumber id="calories" class="form-control" @bind-Value="model.Calories" />
                    <ValidationMessage For="@(() => model.Calories)" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="carbohydrates">Carbohydrates</label>
                    <InputNumber id="carbohydrates" class="form-control" @bind-Value="model.Carbohydrates" />
                    <ValidationMessage For="@(() => model.Carbohydrates)" />
                </div>
            </div>

            <div class="grid">
                <div class="form-group">
                    <label class="form-label" for="protein">Protein</label>
                    <InputNumber id="protein" class="form-control" @bind-Value="model.Protein" />
                    <ValidationMessage For="@(() => model.Protein)" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="fat">Fat</label>
                    <InputNumber id="fat" class="form-control" @bind-Value="model.Fat" />
                    <ValidationMessage For="@(() => model.Fat)" />
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-danger btn-pill" @onclick="OnClose">
                    Discard
                </button>

                <button type="submit" class="btn btn-primary btn-pill" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </EditForm>
    </div>
</ModalContainer>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCreated { get; set; }

    private NewFoodItemModel model = new();
    private bool isSaving;
    private string? error;

    private async Task Save()
    {
        error = null;
        isSaving = true;

        try
        {
            var dto = new CreateFoodItemDto
                {
                    Name = model.Name,
                    Brand = string.IsNullOrWhiteSpace(model.Brand) ? null : model.Brand,
                    Calories = model.Calories,
                    Carbohydrates = model.Carbohydrates,
                    Protein = model.Protein,
                    Fat = model.Fat
                };

            var success = await FoodItemService.CreateAsync(dto);

            if (!success)
            {
                error = "Could not save food item.";
                return;
            }

            await OnCreated.InvokeAsync();
        }
        catch
        {
            error = "Something went wrong.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private class NewFoodItemModel
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(100)]
        public string Name { get; set; } = "";

        [StringLength(100)]
        public string Brand { get; set; } = "";

        [Range(0.01, 2000, ErrorMessage = "Enter valid calories")]
        public double Calories { get; set; }

        [Range(0, 500, ErrorMessage = "Enter valid carbohydrates")]
        public double Carbohydrates { get; set; }

        [Range(0, 500, ErrorMessage = "Enter valid protein")]
        public double Protein { get; set; }

        [Range(0, 500, ErrorMessage = "Enter valid fat")]
        public double Fat { get; set; }
    }
}