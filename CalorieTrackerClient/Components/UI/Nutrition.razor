@page "/nutrition"
@attribute [Authorize]
@inject INutritionService NutritionService
@inject IMealService MealService

<div class="nutrition-dashboard">
    <div class="date-nav">
        <button class="btn-icon" type="button" @onclick="PreviousDay" aria-label="Previous day">&lt;</button>
        <span>@CurrentDateLabel</span>
        <button class="btn-icon" type="button" @onclick="NextDay" aria-label="Next day">&gt;</button>
    </div>

    <CardContainer>
        <div class="calorie-card">
            @if (isLoading)
            {
                    <p class="status-text">Loading...</p>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                    <p class="status-text error">@errorMessage</p>
            }
            else if (nutrition is not null)
            {
                    <div class="calorie-ring">
                        <svg viewBox="0 0 120 120">
                            <path class="ring-bg" d="M30 95 A45 45 0 1 1 90 95" />
                            <path class="ring-fill" d="M30 95 A45 45 0 1 1 90 95"
                                  style="stroke-dasharray:@CalorieDash 220;" />
                        </svg>
                        <div class="ring-text">
                            <span>@ConsumedCalories.ToString("0")/@nutrition.DailyCalories.ToString("0") cal</span>
                            <strong>@CaloriesLeft.ToString("0")</strong>
                            <small>Cal left</small>
                        </div>
                    </div>

                    <div class="water-bar">
                        <div></div>
                    </div>
            }
        </div>
    </CardContainer>

    @if (nutrition is not null)
    {
            <div class="macro-grid">
                <MacroCard Name="Carbohydrates" Current="@consumedCarbs"   Target="@nutrition.Macros.CarbsGrams" />
                <MacroCard Name="Protein"       Current="@consumedProtein" Target="@nutrition.Macros.ProteinGrams" />
                <MacroCard Name="Fat"           Current="@consumedFat"     Target="@nutrition.Macros.FatGrams" />
            </div>
    }

    <FoodLog Date="@selectedDate" OnChanged="LoadDataAsync" />
</div>

@code {
    [Parameter] public EventCallback OnMounted { get; set; }

    private NutritionResponseDto? nutrition;
    private bool isLoading = true;
    private string? errorMessage;

    private DateTime selectedDate = DateTime.Today;

    private double ConsumedCalories;
    private double consumedProtein;
    private double consumedCarbs;
    private double consumedFat;

    private string CurrentDateLabel =>
        selectedDate.Date == DateTime.Today.Date ? "Today" : selectedDate.ToString("MMM d");

    private double CaloriesLeft =>
        nutrition is null ? 0 : Math.Max(0, nutrition.DailyCalories - ConsumedCalories);

    private double CalorieProgress =>
        nutrition is null || nutrition.DailyCalories <= 0
            ? 0 : Math.Clamp(ConsumedCalories / nutrition.DailyCalories, 0, 1);

    private double CalorieDash => CalorieProgress * 220;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await OnMounted.InvokeAsync();
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        await LoadDataAsync();
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        await LoadDataAsync();
    }

    public async Task RefreshNutritionTargetsAsync()
    {
        await InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            nutrition = await NutritionService.GetMineAsync();

            var meals = await MealService.GetByDateAsync(selectedDate);

            ConsumedCalories = consumedProtein = consumedCarbs = consumedFat = 0;

            if (meals is not null)
            {
                foreach (var entry in meals.SelectMany(m => m.MealEntries))
                {
                    double ratio = entry.QuantityInGrams / 100.0;
                    ConsumedCalories += entry.FoodItem.Calories * ratio;
                    consumedProtein += entry.FoodItem.Protein * ratio;
                    consumedCarbs += entry.FoodItem.Carbohydrates * ratio;
                    consumedFat += entry.FoodItem.Fat * ratio;
                }
            }
        }
        catch
        {
            errorMessage = "Could not load nutrition values.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
