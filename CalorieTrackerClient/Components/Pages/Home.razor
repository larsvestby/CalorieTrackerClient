@page "/home"
@attribute [Authorize]
@using CalorieTrackerClient.Components.Layout

<Nutrition @ref="nutritionRef" />

@code {
    [CascadingParameter] private MainLayout? Layout { get; set; }

    private Nutrition? nutritionRef;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Layout is not null && nutritionRef is not null)
        {
            Layout.RegisterNutrition(nutritionRef);
        }
    }
}