@attribute [Authorize]
@inject IAuthService AuthService
@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="top-row">
            <button class="btn btn-muted btn-pill" type="button">User settings</button>
            <button class="btn btn-primary btn-pill" type="button" @onclick="Logout">Logout</button>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        AuthStateProvider.NotifyUserLogout();
        Navigation.NavigateTo("/login", true);
    }
}